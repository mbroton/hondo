---
interface Props {
  size?: number;
}

const { size = 30 } = Astro.props;
---

<a class="logo" href="/" aria-label="Hondo home">
  <img src="/hat.webp" alt="" width={size} height={size} />
  <span>hondo</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-size: 23px;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  .logo img {
    transform: rotate(-8deg) translateY(-1px);
  }
</style>
