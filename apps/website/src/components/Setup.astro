---
import { repoHref } from "../site";
import Arrow from "./Arrow.astro";
---

<section class="section wrap" id="setup" aria-labelledby="setup-title">
  <div class="section-head">
    <h2 class="duo" id="setup-title">
      three steps <span>then ask your first question</span>
    </h2>
    <a class="pill head-cta" href={repoHref}>
      Read the setup guide <Arrow />
    </a>
  </div>

  <ol class="steps">
    <li class="step">
      <div class="mock" aria-hidden="true">
        <span class="slack-btn">
          <img src="/hat.webp" alt="" width="22" height="22" />
          Add to Slack
        </span>
      </div>
      <h3>Run it and add it to Slack</h3>
      <p>One docker compose up. Then save your model key.</p>
    </li>
    <li class="step">
      <div class="mock list" aria-hidden="true">
        <span>
          <i class="ok"></i>GitHub
        </span>
        <span>
          <i class="ok"></i>Atlassian
        </span>
        <span>
          <i></i>Any MCP server
        </span>
      </div>
      <h3>Connect your tools</h3>
      <p>Approve the tools and pick the channels.</p>
    </li>
    <li class="step">
      <div class="mock" aria-hidden="true">
        <span class="ask">
          <b>@hondo</b> what changed since 10:00?
        </span>
      </div>
      <h3>Mention @hondo</h3>
      <p>In the incident thread.</p>
    </li>
  </ol>
</section>

<style>
  .head-cta {
    margin-top: 28px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    counter-increment: step;
    padding: 12px 12px 26px;
    border-radius: var(--radius-xl);
    background: var(--panel);
  }

  .mock {
    display: grid;
    place-items: center;
    height: 168px;
    margin-bottom: 22px;
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: 0 1px 2px rgb(32 28 25 / 0.06);
  }

  .slack-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid #ddd8d3;
    border-radius: 10px;
    font-weight: 600;
    font-size: 15px;
  }

  .list {
    align-content: center;
    justify-items: start;
    gap: 8px;
    padding-left: 22%;
    font-size: 15px;
  }

  .list span {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .list i {
    width: 14px;
    height: 14px;
    border: 1.5px solid #c9c3bd;
    border-radius: 50%;
  }

  .list i.ok {
    border-color: #2f8f5b;
    background: #2f8f5b;
    box-shadow: inset 0 0 0 3px #fff;
  }

  .ask {
    padding: 10px 14px;
    border: 1px solid #ddd8d3;
    border-radius: 10px;
    font-size: 14.5px;
  }

  .ask b {
    color: #1264a3;
    background: #e8f5fa;
    border-radius: 3px;
    padding: 0 2px;
    font-weight: 400;
  }

  h3,
  p {
    padding-inline: 14px;
  }

  h3 {
    margin: 0;
    font-weight: 500;
    font-size: 19px;
    letter-spacing: -0.025em;
  }

  h3::before {
    content: counter(step);
    display: block;
    margin-bottom: 6px;
    color: var(--dust);
    font-size: 14px;
    font-weight: 400;
  }

  p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
