---
import Msg from "./slack/Msg.astro";
import Status from "./slack/Status.astro";
import TaskCard from "./slack/TaskCard.astro";
import Thread from "./slack/Thread.astro";
import Window from "./slack/Window.astro";

const maya = { name: "Maya", color: "#2f7d8c" };
const jonas = { name: "Jonas", color: "#7a5bb5" };
const priya = { name: "Priya", color: "#c2577a" };
const sam = { name: "Sam", color: "#4f7a3a" };
const tom = { name: "Tom", color: "#b07a1f" };

const tabs = [
  {
    id: "changed",
    label: "find what changed",
    channel: "inc-checkout",
    lead: "ask what changed.",
    rest: "Deploys, pull requests, config and flag changes, in one message.",
  },
  {
    id: "steer",
    label: "steer it together",
    channel: "inc-eu-502",
    lead: "reply while it works.",
    rest: "Anyone in the thread can add a detail or change the plan. Hondo uses it at its next step.",
  },
  {
    id: "remember",
    label: "remember last time",
    channel: "inc-orders",
    lead: "it remembers.",
    rest: "Hondo keeps a short summary of each thread it joins, and finds past incidents with a date and a link.",
  },
  {
    id: "runbook",
    label: "write the runbook",
    channel: "inc-checkout",
    lead: "write it once.",
    rest: "The person who knows turns a thread into a runbook. Hondo follows it the next time.",
  },
];
---

<section
  class="demo wrap"
  id="features"
  aria-label="Hondo in an incident thread"
>
  <div class="stage" data-demo>
    <img class="hat" src="/hat.webp" alt="" width="220" height="220" data-hat />
    <Window
      active="inc-checkout"
      channels={["eng", "deploys", "inc-checkout", "inc-eu-502", "inc-orders"]}
    >
      <div class="panels">
        <div
          class="panel"
          id="panel-changed"
          role="tabpanel"
          aria-labelledby="tab-changed"
          data-panel
        >
          <Thread channel="inc-checkout">
            <Msg who="alerts" time="10:06" still>
              <p>
                <b>checkout-api</b> error rate is 7.2% (threshold 2%)
              </p>
            </Msg>
            <Msg who={maya} time="10:07" at={300}>
              <p>
                <span class="at">@Hondo</span> what changed in checkout since
                10:00?
              </p>
            </Msg>
            <Msg who="hondo" time="10:07" at={1500}>
              <p>on it, checking deploys and merged PRs</p>
              <TaskCard
                at={2000}
                items={[
                  { text: "List deploys since 10:00", run: 2000, done: 3300 },
                  { text: "Read the diff of PR #412", run: 3300, done: 4800 },
                  { text: "Compare error traces", run: 4800, done: 6300 },
                ]}
              />
            </Msg>
            <Msg who="hondo" time="10:09" at={6500}>
              <p>
                Deploy #219 went out at 10:04 with PR #412. It cut the payment
                timeout from 30 s to 3 s, and all 1,284 new errors are timeouts
                on <code>/pay</code>. A rollback of #219 should stop them.
              </p>
              <p class="muted">
                Sources:{" "}
                <a class="src" href="#features">
                  deploy #219
                </a>{" "}
                /{" "}
                <a class="src" href="#features">
                  PR #412
                </a>{" "}
                /{" "}
                <a class="src" href="#features">
                  1,284 traces
                </a>
              </p>
            </Msg>
            <Msg who={maya} time="10:10" at={8600}>
              <p>rolling back 🙏</p>
            </Msg>
            <Status
              slot="status"
              end={6500}
              steps={[
                {
                  text: "Listing deploys since 10:00 (3 tool calls)",
                  at: 1700,
                },
                { text: "Reading PR #412 (6 tool calls)", at: 3300 },
                { text: "Comparing error traces (11 tool calls)", at: 4800 },
              ]}
            />
          </Thread>
        </div>

        <div
          class="panel"
          id="panel-steer"
          role="tabpanel"
          aria-labelledby="tab-steer"
          data-panel
          hidden
        >
          <Thread channel="inc-eu-502">
            <Msg who={jonas} time="14:21" at={200}>
              <p>
                <span class="at">@Hondo</span> why are EU users getting 502s?
              </p>
            </Msg>
            <Msg who="hondo" time="14:21" at={1300}>
              <p>on it, starting with the load balancer logs</p>
            </Msg>
            <Msg who={priya} time="14:22" at={2700}>
              <p>it started with the 14:00 deploy, check that first</p>
            </Msg>
            <Msg who="hondo" time="14:22" at={3900}>
              <p>got it, starting with the 14:00 deploy</p>
            </Msg>
            <Msg who={sam} time="14:22" at={4900}>
              <p>staging looks fine fwiw</p>
            </Msg>
            <Msg who="hondo" time="14:24" at={7200}>
              <p>
                Deploy #233 at 14:00 moved eu-west to the new ingress, and its
                health check calls <code>/health</code> instead of{" "}
                <code>/healthz</code>. Staging still uses the old ingress, so it
                looks fine.
              </p>
              <p class="muted">
                Sources:{" "}
                <a class="src" href="#features">
                  deploy #233
                </a>{" "}
                /{" "}
                <a class="src" href="#features">
                  ingress.yaml line 42
                </a>{" "}
                /{" "}
                <a class="src" href="#features">
                  load balancer logs
                </a>
              </p>
            </Msg>
            <Status
              slot="status"
              end={7200}
              steps={[
                { text: "Reading load balancer logs (2 tool calls)", at: 1600 },
                { text: "Reading deploy #233 (5 tool calls)", at: 4100 },
                {
                  text: "Checking the ingress config (8 tool calls)",
                  at: 5600,
                },
              ]}
            />
          </Thread>
        </div>

        <div
          class="panel"
          id="panel-remember"
          role="tabpanel"
          aria-labelledby="tab-remember"
          data-panel
          hidden
        >
          <Thread channel="inc-orders">
            <Msg who="alerts" time="09:12" still>
              <p>
                <b>orders-api</b>: connection pool exhausted (42 events)
              </p>
            </Msg>
            <Msg who={sam} time="09:13" at={200}>
              <p>
                <span class="at">@Hondo</span> have we seen this on orders-api
                before?
              </p>
            </Msg>
            <Msg who="hondo" time="09:14" at={3200}>
              <p>
                Yes, on 12 August in <span class="at">#inc-orders</span>. A
                migration dropped the index on <code>orders.created_at</code>,
                and Tom fixed it with a hotfix. Same error text, same service.
              </p>
              <p>My guess: check if today's migration touched that table.</p>
              <p class="muted">
                Source:{" "}
                <a class="src" href="#features">
                  thread from 12 August
                </a>
              </p>
            </Msg>
            <Msg who={tom} time="09:15" at={5400}>
              <p>it did. adding the index back now</p>
            </Msg>
            <Status
              slot="status"
              end={3200}
              steps={[
                { text: "Searching past threads (1 tool call)", at: 1000 },
                {
                  text: "Reading the 12 August thread (2 tool calls)",
                  at: 2100,
                },
              ]}
            />
          </Thread>
        </div>

        <div
          class="panel"
          id="panel-runbook"
          role="tabpanel"
          aria-labelledby="tab-runbook"
          data-panel
          hidden
        >
          <Thread channel="inc-checkout">
            <Msg who={tom} time="10:31" still>
              <p>rollback done, errors are back to normal</p>
            </Msg>
            <Msg who={tom} time="10:32" at={300}>
              <p>
                <span class="at">@Hondo</span> turn this thread into a runbook
              </p>
            </Msg>
            <Msg who="hondo" time="10:33" at={3800}>
              <p>
                Drafted the skill <code>rollback-checkout-deploy</code> from
                this thread: 5 steps, from the rollback to the error check. An
                admin can publish it in the dashboard.
              </p>
              <p class="muted">
                <a class="src" href="#features">
                  Open the draft
                </a>
              </p>
            </Msg>
            <Msg who={maya} time="10:34" at={5600}>
              <p>published it for all #inc channels 👍</p>
            </Msg>
            <Status
              slot="status"
              end={3800}
              steps={[
                { text: "Reading the thread (1 tool call)", at: 1200 },
                { text: "Writing the skill (2 tool calls)", at: 2400 },
              ]}
            />
          </Thread>
        </div>
      </div>
    </Window>
  </div>

  <div class="tabs" role="tablist" aria-label="What Hondo does in a thread">
    {tabs.map((tab, i) => (
      <button
        class="tab"
        id={`tab-${tab.id}`}
        role="tab"
        type="button"
        aria-selected={i === 0 ? "true" : "false"}
        aria-controls={`panel-${tab.id}`}
        tabindex={i === 0 ? 0 : -1}
        data-tab={i}
        data-channel={tab.channel}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div class="captions">
    {tabs.map((tab, i) => (
      <p class="caption" data-caption={i} data-on={i === 0 ? "" : undefined}>
        <b>{tab.lead}</b> {tab.rest}
      </p>
    ))}
  </div>
</section>

<style>
  .demo {
    padding-top: clamp(64px, 9vw, 104px);
  }

  .stage {
    position: relative;
    max-width: 960px;
    margin-inline: auto;
  }

  .hat {
    position: absolute;
    z-index: 2;
    top: -86px;
    right: -64px;
    width: clamp(120px, 20vw, 220px);
    height: auto;
    transform: rotate(14deg);
    filter: drop-shadow(0 18px 18px rgb(59 36 24 / 0.22));
    pointer-events: none;
  }

  .stage[data-ready] .hat {
    opacity: 0;
    transform: translateY(-160px) rotate(-28deg);
  }

  .stage[data-landed] .hat {
    opacity: 1;
    animation: hat-drop 1100ms var(--ease-drawer) both;
  }

  @keyframes hat-drop {
    0% {
      opacity: 0;
      transform: translateY(-160px) rotate(-28deg);
    }
    18% {
      opacity: 1;
    }
    62% {
      transform: translateY(8px) rotate(19deg);
    }
    80% {
      transform: translateY(-4px) rotate(11deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(14deg);
    }
  }

  .panels {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
  }

  .panel[hidden] {
    display: none;
  }

  .tabs {
    position: relative;
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 40px auto 0;
    padding: 4px;
    gap: 2px;
    overflow-x: auto;
    border-radius: 999px;
    background: var(--panel);
    scrollbar-width: none;
  }

  .tab {
    flex: none;
    height: 38px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
    cursor: pointer;
    transition:
      background 200ms var(--ease-out),
      color 200ms,
      box-shadow 200ms;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab[aria-selected="true"] {
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(32 28 25 / 0.08),
      0 2px 8px -2px rgb(32 28 25 / 0.08);
  }

  .captions {
    display: grid;
    max-width: 560px;
    margin: 22px auto 0;
    text-align: center;
  }

  .caption {
    grid-area: 1 / 1;
    margin: 0;
    color: var(--dust);
    font-size: 18px;
    line-height: 1.45;
    opacity: 0;
    filter: blur(6px);
    transform: translateY(6px);
    transition:
      opacity 360ms var(--ease-out),
      filter 360ms var(--ease-out),
      transform 420ms var(--ease-out);
    pointer-events: none;
  }

  .caption[data-on] {
    opacity: 1;
    filter: none;
    transform: none;
    pointer-events: auto;
  }

  .caption b {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .hat {
      top: -54px;
      right: -14px;
    }
  }
</style>

<script>
  import { duration, finish, play, reducedMotion } from "../scripts/timeline";

  const stage = document.querySelector<HTMLElement>("[data-demo]");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
  const captions = [
    ...document.querySelectorAll<HTMLElement>("[data-caption]"),
  ];
  const sideChannels = [
    ...document.querySelectorAll<HTMLElement>("[data-demo] [data-channel]"),
  ];

  if (stage) {
    const reduce = reducedMotion();
    let current = 0;
    let cancel = () => {};
    let advance = 0;
    let auto = true;
    let visible = false;
    let pending = true;

    const scrollDown = (panel: HTMLElement) => {
      const box = panel.querySelector<HTMLElement>("[data-scroll]");
      if (box) box.scrollTop = box.scrollHeight;
    };

    const start = () => {
      pending = false;
      cancel();
      window.clearTimeout(advance);
      const panel = panels[current];
      if (reduce) {
        finish(panel);
        scrollDown(panel);
        return;
      }
      cancel = play(panel, () => scrollDown(panel));
      if (auto) {
        advance = window.setTimeout(
          () => select((current + 1) % panels.length, false),
          duration(panel) + 3200,
        );
      }
    };

    const select = (index: number, byUser: boolean) => {
      if (byUser) auto = false;
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));
      captions.forEach((c, i) => c.toggleAttribute("data-on", i === index));
      const tab = tabs[index];
      const strip = tab.parentElement;
      strip?.scrollTo({
        left: tab.offsetLeft - (strip.clientWidth - tab.offsetWidth) / 2,
        behavior: reduce ? "auto" : "smooth",
      });
      const channel = tab.dataset.channel;
      sideChannels.forEach((el) =>
        el.classList.toggle("active", el.dataset.channel === channel),
      );
      pending = true;
      if (visible || byUser) start();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, true));
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = (i + step + tabs.length) % tabs.length;
        select(next, true);
        tabs[next].focus();
      });
    });

    if (reduce) {
      panels.forEach(finish);
    } else {
      stage.setAttribute("data-ready", "");
    }

    let landed = false;
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (!visible) return;
        if (!landed) {
          landed = true;
          stage.setAttribute("data-landed", "");
        }
        if (pending) start();
      },
      { threshold: 0.35 },
    ).observe(stage);
  }
</script>
