# Hondo settings. Copy to .env and replace each "..." value.
# Docker Compose and the development commands (make api, make worker) read this file.

# The HTTPS address where people open the dashboard. Slack OAuth redirects come back here.
HONDO_API__PUBLIC_BASE_URL=https://hondo.example.com

# From your Slack app (api.slack.com/apps). Basic Information: client ID and client secret.
HONDO_AUTH__SLACK__CLIENT_ID=...
HONDO_AUTH__SLACK__CLIENT_SECRET=...
# Basic Information > App-Level Tokens: a token with the connections:write scope (xapp-...).
HONDO_WORKSPACE__SLACK__APP_TOKEN=xapp-...

# Encrypts Slack tokens, model keys and connector credentials in the database.
# If you lose it, you must install Hondo in Slack again and enter all keys again.
# Keep a backup apart from the database backup.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
HONDO_CRYPTO__TOKEN_KEY=...

# Signs the short-lived sign-in state cookie. At least 32 bytes.
# Generate: openssl rand -base64 48
HONDO_API__SESSION_SECRET=...

# Docker Compose only: the host address and port of the API and dashboard.
# Keep it on 127.0.0.1 and put an HTTPS reverse proxy in front.
# HONDO_PORT=127.0.0.1:8000
# Docker Compose only: use a released image instead of a build from source.
# HONDO_IMAGE=ghcr.io/mbroton/hondo:VERSION

# Development only (make api, make worker). Docker Compose sets its own database URL.
# For local development, set HONDO_API__PUBLIC_BASE_URL to the HTTPS address of the Vite dev server.
HONDO_DATABASE__URL=postgresql://hondo:hondo@localhost:5455/hondo

# MCP connectors accept only public HTTPS servers. Set to true to also accept
# private addresses and plain HTTP, for MCP servers in your own network.
# Admins can then connect to all addresses that the Hondo server can reach,
# except link-local and cloud metadata addresses.
# HONDO_CONNECTORS__ALLOW_PRIVATE_NETWORKS=false

# Optional: send traces to Logfire.
# HONDO_LOGFIRE__ENABLED=true
# LOGFIRE_TOKEN=...

# Optional
# HONDO_LOGGING__LEVEL=DEBUG
# HONDO_LOGGING__FORMAT=json
